# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Dashboard Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chiave SEGRETA (Supabase > Project Settings > API Keys > Secret keys).
# Solo lato server: serve per accedere con il nome del personaggio.
# Mai con il prefisso NEXT_PUBLIC_, mai nel codice.
SUPABASE_SECRET_KEY=

# Facoltativa, solo lato server: chiave gratuita di proxycheck.io per il
# controllo VPN/proxy degli accessi (senza chiave ~100 controlli al giorno).
PROXYCHECK_API_KEY=
